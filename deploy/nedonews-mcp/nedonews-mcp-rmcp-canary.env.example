# RMCP canary only. Keep this separate from /etc/nedobot/nedonews-mcp.env.
# The existing legacy public service continues on 127.0.0.1:8787.
# Use the read-only role created by bootstrap-role.sql; never commit its password.
ASK_DATABASE_URL=postgresql://nedobot_mcp_ro:REDACTED@127.0.0.1:5432/tg_ai_bot

# The canary has a distinct local listener and external Nginx route.
MCP_BIND=127.0.0.1:8788
MCP_PATH=/mcp/nedonews-rmcp-canary
MCP_MANIFEST=/opt/tg-ai-bot-teloxide/config/mcp_db_manifest.toml

# Nginx proxies the canary with this exact Host header. Do not add arbitrary hosts.
MCP_ALLOWED_HOSTS=nedobot.chickenkiller.com
# Origin-less server-to-server clients remain supported. Browser clients must match exactly.
MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com
RUST_LOG=info
