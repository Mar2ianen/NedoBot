# Use a unique random password for the role created by bootstrap-role.sql.
ASK_DATABASE_URL=postgresql://nedobot_mcp_ro:REDACTED@127.0.0.1:5432/tg_ai_bot
MCP_BIND=127.0.0.1:8787
# RMCP v2 намеренно не использует URL удалённого legacy MCP-контракта.
MCP_PATH=/mcp/nedonews/v2
# Required for public deployment: list the externally accepted Host authorities.
# If absent, RMCP accepts loopback hosts only.
MCP_ALLOWED_HOSTS=mcp.example.com
MCP_MANIFEST=/opt/tg-ai-bot-teloxide/config/mcp_db_manifest.toml
# Empty permits server-to-server MCP clients. A present Origin must be listed here.
MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com
# The tool is advertised but stays unavailable until yt-dlp is installed and enabled.
MCP_YOUTUBE_SUBTITLES_ENABLED=false
MCP_YOUTUBE_SUBTITLES_COMMAND=/usr/bin/yt-dlp
MCP_YOUTUBE_SUBTITLES_LANGUAGES=ru,ru.*,en,en.*
MCP_YOUTUBE_SUBTITLES_TIMEOUT_SEC=15
MCP_YOUTUBE_SUBTITLES_MAX_CHARS=12000
MCP_YOUTUBE_SUBTITLES_MAX_VIDEOS=2
RUST_LOG=info
