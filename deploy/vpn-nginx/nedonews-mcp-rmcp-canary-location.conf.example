# Add this exact location inside the existing TLS server for nedobot.chickenkiller.com.
# It is deliberately a new route: do not alter location = /mcp/nedonews.
location = /mcp/nedonews-rmcp-canary {
    proxy_pass http://127.0.0.1:8788/mcp/nedonews-rmcp-canary;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    include /etc/nedobot/nginx/mcp-rate-limit-location.conf;

    proxy_buffering off;
    proxy_cache off;
    client_max_body_size 64k;
    client_body_timeout 15s;
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    # Leave headroom for the upstream's 60-second request deadline.
    proxy_read_timeout 70s;
}
