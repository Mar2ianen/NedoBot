# Non-secret runtime settings live in config/llm_profiles.toml.example under [runtime].
# For a deployment-specific profile file, set LLM_PROFILES_PATH in the process
# environment or systemd unit; do not put it in this secrets file.

# Telegram and database credentials
TELOXIDE_TOKEN=
DATABASE_URL=

# Sensitive URLs
CHAT_INVITE_URL=
LLM_PROXY_URL=

# LLM provider credentials referenced by api_key_env in the profiles
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OLLAMA_API_KEY=
OPENAI_COMPAT_API_KEY=

# Credentials passed to child processes or external deployment tools
ASK_DATABASE_URL=
GITHUB_PERSONAL_ACCESS_TOKEN=
CLOUDFLARE_API_TOKEN=
OPENCODE_API_KEY=
