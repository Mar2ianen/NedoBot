# LLM topology: provider transport -> model profile -> task route.
# This file contains no API keys. api_key_env names the required environment variable.
# By default the bot loads this file. Set LLM_PROFILES_PATH in the process
# environment when deployment needs a separate copy. Task routes are the only
# source of provider/model/capabilities for runtime generation. The [runtime]
# section is required; missing it is a startup error.

[providers.gemini]
driver = "gemini"
adapter = "gemini"
egress = "direct"
base_url = "https://generativelanguage.googleapis.com/v1beta"
api_key_env = "GEMINI_API_KEY"

[providers.ollama_cloud]
driver = "ollama_native"
adapter = "ollama_cloud"
egress = "direct"
base_url = "https://ollama.com"
api_key_env = "OLLAMA_API_KEY"

[providers.groq]
driver = "openai_compatible"
adapter = "groq"
egress = "direct"
base_url = "https://api.groq.com/openai/v1"
api_key_env = "GROQ_API_KEY"

[providers.cerebras]
driver = "openai_compatible"
adapter = "open_ai"
egress = "direct"
base_url = "https://api.cerebras.ai/v1"
api_key_env = "CEREBRAS_API_KEY"

[providers.openrouter]
driver = "openai_compatible"
adapter = "open_router"
egress = "direct"
base_url = "https://openrouter.ai/api/v1"
api_key_env = "OPENROUTER_API_KEY"

[providers.custom_openai]
driver = "openai_compatible"
adapter = "open_ai"
egress = "direct"
base_url = "https://api.openai.com/v1"
api_key_env = "OPENAI_COMPAT_API_KEY"

# Опциональный Workers AI; заменить ACCOUNT_ID собственным ID в private profile.
# Добавление provider/model не включает его в routes автоматически.
[providers.cloudflare]
driver = "openai_compatible"
adapter = "open_ai"
egress = "direct"
base_url = "https://api.cloudflare.com/client/v4/accounts/ACCOUNT_ID/ai/v1"
api_key_env = "CLOUDFLARE_API_TOKEN"

[models.cloudflare_gemma_audit]
provider = "cloudflare"
model = "@cf/google/gemma-4-26b-a4b-it"
chat_template_kwargs = { enable_thinking = false }

[models.cloudflare_gemma_audit.capabilities]
supports_images = true
supports_tools = false
supports_system_prompt = true
structured_output = "json_schema"
context_window_tokens = 256000
max_output_tokens = 4096
request_timeout_sec = 60
thinking = "none"

# Резервный research-план: Cloudflare Workers AI Gemma 4. JSON Object вместо
# JSON Schema, потому что schema-ответ на коротком бюджете обрывался; typed
# validator в search_extract по-прежнему проверяет полный контракт.
[models.cloudflare_gemma_search]
provider = "cloudflare"
model = "@cf/google/gemma-4-26b-a4b-it"
chat_template_kwargs = { enable_thinking = false }

[models.cloudflare_gemma_search.capabilities]
supports_images = false
supports_tools = false
supports_system_prompt = true
structured_output = "json_object"
context_window_tokens = 256000
max_output_tokens = 4096
request_timeout_sec = 60
thinking = "none"

# Gemini 4 Hydrogen: бесплатная модель Gemini API. Reasoning входит в
# maxOutputTokens, поэтому thinking_headroom_tokens добавляет запас поверх
# короткого runtime.llm_max_tokens и не даёт ответу оборваться на MAX_TOKENS.
# thinking=medium — обычный уровень, без экономии на reasoning.
[models.gemini_hydrogen_comment]
provider = "gemini"
model = "gemini-4-hydrogen"

[models.gemini_hydrogen_comment.capabilities]
supports_images = true
supports_tools = true
supports_system_prompt = true
structured_output = "json_schema"
context_window_tokens = 1048576
max_output_tokens = 65536
thinking_headroom_tokens = 8192
request_timeout_sec = 60
thinking = "level_medium"

# Gemma 4 на Gemini API: hosted-профиль для research-плана первого комментария.
# Google Search grounding для Gemma 4 на free tier недоступен; веб-поиск
# выполняет отдельный MCP provider. thinking=high — не экономим на reasoning.
[models.gemini_gemma4_extract]
provider = "gemini"
model = "gemma-4-31b-it"

[models.gemini_gemma4_extract.capabilities]
supports_images = true
supports_tools = true
supports_system_prompt = true
structured_output = "json_schema"
context_window_tokens = 262144
max_output_tokens = 16384
thinking_headroom_tokens = 8192
request_timeout_sec = 120
thinking = "level_high"

[models.gemini_38_comment]
provider = "gemini"
model = "gemini-3.8-flash"

[models.gemini_38_comment.capabilities]
supports_images = true
supports_tools = true
supports_system_prompt = true
structured_output = "json_schema"
context_window_tokens = 1000000
max_output_tokens = 16384
thinking_headroom_tokens = 8192
request_timeout_sec = 60
thinking = "level_medium"

[models.gemini_37_comment]
provider = "gemini"
model = "gemini-3.7-flash"

[models.gemini_37_comment.capabilities]
supports_images = true
supports_tools = true
supports_system_prompt = true
structured_output = "json_schema"
context_window_tokens = 1000000
max_output_tokens = 16384
thinking_headroom_tokens = 8192
request_timeout_sec = 60
thinking = "level_high"

[models.gemini_comment]
provider = "gemini"
model = "gemini-3.6-flash"

[models.gemini_comment.capabilities]
supports_images = true
supports_tools = true
supports_system_prompt = true
structured_output = "json_schema"
context_window_tokens = 1000000
max_output_tokens = 16384
thinking_headroom_tokens = 8192
request_timeout_sec = 60
thinking = "level_medium"

[models.gemini_flash_comment]
provider = "gemini"
model = "gemini-3.5-flash"

[models.gemini_flash_comment.capabilities]
supports_images = true
supports_tools = true
supports_system_prompt = true
structured_output = "json_schema"
context_window_tokens = 1000000
max_output_tokens = 16384
thinking_headroom_tokens = 8192
request_timeout_sec = 60
thinking = "level_medium"

# Отдельный timeout для /ask; профиль комментариев имеет собственный бюджет.
[models.gemini_ask]
provider = "gemini"
model = "gemini-3.5-flash"

[models.gemini_ask.capabilities]
supports_images = true
supports_tools = true
supports_system_prompt = true
structured_output = "json_schema"
context_window_tokens = 1000000
max_output_tokens = 65536
request_timeout_sec = 180
thinking = "level_high"

[models.gemini_flash_lite_comment]
provider = "gemini"
model = "gemini-3.5-flash-lite"

[models.gemini_flash_lite_comment.capabilities]
supports_images = true
supports_tools = true
supports_system_prompt = true
structured_output = "json_schema"
context_window_tokens = 1000000
max_output_tokens = 16384
thinking_headroom_tokens = 8192
request_timeout_sec = 60
thinking = "level_medium"

[models.ollama_memory]
provider = "ollama_cloud"
model = "gemma4:31b"

[models.ollama_memory.capabilities]
supports_images = false
supports_tools = true
supports_system_prompt = true
structured_output = "prompt_only"
context_window_tokens = 32768
max_output_tokens = 4096
request_timeout_sec = 120
thinking = "none"

[models.ollama_audit]
provider = "ollama_cloud"
model = "gemma4:31b"

[models.ollama_audit.capabilities]
supports_images = true
supports_tools = true
supports_system_prompt = true
structured_output = "prompt_only"
context_window_tokens = 32768
max_output_tokens = 4096
