[routes.first_comment]
models = [
  "gemini_hydrogen_comment",
  "gemini_38_comment",
  "gemini_37_comment",
  "gemini_comment",
  "gemini_flash_comment",
  "gemini_flash_lite_comment",
]
# Для комментария действует строгий product-validator; при нарушении
# контракта одной моделью нужно перейти к следующей модели route.
fallback_on_validation_failure = true

[routes.memory]
models = ["ollama_memory"]

[routes.voice_cleanup]
models = ["groq_qwen_cleanup", "openrouter_qwen_fallback", "ollama_memory"]
fallback_on_validation_failure = true

[routes.new_user_audit]
models = ["ollama_audit"]

[routes.search_extract]
models = ["gemini_gemma4_extract", "cloudflare_gemma_search"]
# Если Gemma 4 нарушит JSON-контракт research-плана или упрётся в лимит,
# поиск не должен останавливаться: план строит Cloudflare Gemma 4.
fallback_on_validation_failure = true

[routes.ask]
models = [
  "groq_qwen_ask",
  "openrouter_free_ask",
  "ollama_minimax",
  "ollama_memory",
]

# Non-secret bot/runtime configuration. Credentials, DSNs, invite/proxy URLs and
# API keys stay in the process environment and are not stored in this file.
[runtime]
render_timezone = "Europe/Moscow"
stats_locale = "ru"

llm_temperature = 0.35
llm_max_tokens = 140
memory_llm_temperature = 0.2
memory_llm_max_tokens = 220

rag_enabled = false
rag_embedding_url = "http://127.0.0.1:8788"
rag_embedding_model = "onnx-community/embeddinggemma-2-ONNX@daa72c51243991dfcaf9f9137d2c573d8f7790c0:q4"
rag_embedding_timeout_sec = 60
rag_top_k = 6
rag_min_similarity = 0.55
rag_temporal_half_life_days = 180.0

chat_retrieval_embeddings_enabled = false
chat_retrieval_embedding_url = "http://127.0.0.1:8788"
chat_retrieval_embedding_model = "onnx-community/embeddinggemma-2-ONNX@daa72c51243991dfcaf9f9137d2c573d8f7790c:q4"
chat_retrieval_embedding_timeout_sec = 60
chat_retrieval_embedding_query_prefix = "task: search result | query: "
chat_retrieval_embedding_document_prefix = "title: none | text: "
chat_retrieval_embedding_batch_size = 16
chat_retrieval_embedding_poll_sec = 5
chat_retrieval_shadow_enabled = false
chat_retrieval_evidence_enabled = false
chat_retrieval_evidence_min_score = 2.0
chat_retrieval_window_days = 30
chat_retrieval_half_life_days = 7.0

search_enabled = false
search_extract_temperature = 0.1
search_extract_max_tokens = 900
search_mcp_command = "env"
search_mcp_args = ["MODE=stdio", "DEFAULT_SEARCH_ENGINE=duckduckgo", "SEARCH_MODE=request", "MCP_TOOL_SEARCH_NAME=search", "npx", "--yes", "open-websearch@2.2.0"]
search_mcp_env = ["PATH", "HOME"]
search_mcp_timeout_sec = 30
search_query_timeout_sec = 20
search_mcp_tool_web = "search"
search_mcp_tool_github = "search"
search_mcp_tool_reddit = "search"
search_mcp_tool_fetch = ""
search_fetch_top_n = 4
search_fetch_max_chars = 16000
youtube_subtitles_enabled = true
youtube_subtitles_command = "yt-dlp"
youtube_subtitles_languages = ["ru", "ru.*", "en", "en.*"]
youtube_subtitles_timeout_sec = 60
youtube_subtitles_max_chars = 12000
youtube_subtitles_max_videos = 2
comment_blocked_source_domains = [
  "meduza.io", "theins.ru", "tvrain.tv", "novayagazeta.eu",
  "zona.media", "istories.media", "holod.media", "verstka.media",
  "proekt.media",
  "thebell.io", "currenttime.tv", "svoboda.org", "severreal.org",
  "ridl.io", "doxa.team", "7x7-journal.ru", "paperpaper.ru",
]
comment_blocked_terms = []
search_github_mcp_args = []
search_github_mcp_env = ["PATH", "HOME", "GITHUB_PERSONAL_ACCESS_TOKEN"]
search_github_mcp_tools = ["search_issues", "search_code"]

new_user_audit_enabled = false
avatar_embeddings_enabled = false
new_user_audit_max_tokens = 900
gemini_thinking_budget = 1024
owner_telegram_id = 5939287960
send_owner_preview = true

ask_enabled = false
ask_allow_chat_admins = true
ask_private_user_ids = []
ask_llm_temperature = 0.2
# Бюджет исследования: до 64 tools и 68 LLM turns с резервом на финальный ответ.
ask_llm_max_tokens = 16384
ask_max_steps = 64
ask_action_timeout_sec = 180
ask_total_timeout_sec = 3600
ask_max_concurrency = 4
ask_db_mcp_args = []
ask_db_mcp_env = ["ASK_DATABASE_URL", "MCP_MANIFEST"]
ask_db_mcp_timeout_sec = 30
ask_python_sandbox_enabled = false
# Опционально; требуется отдельный rootless пользователь nedobot-sandbox и локальный ID образа.
# ask_python_sandbox_image = "sha256:<64 hex digits>"

profile_refresh_concurrency = 4
comment_custom_emoji_id = "5445092965875729965"
first_comment_max_image_mb = 10
tech_custom_emoji_id = "5445122339157065472"
amd_custom_emoji_id = "5442995600201106682"
radeon_custom_emoji_id = "5442853853395436819"
ryzen_custom_emoji_id = "5444875271163364561"

voice_transcription_enabled = false
voice_auto_transcribe = false
voice_max_duration_sec = 600
voice_max_file_mb = 20
voice_short_text_max_chars = 400
voice_language = "ru"
voice_asr_provider = "gemini"
voice_asr_model = "gemini-3.5-transcribe"
voice_asr_shadow_enabled = true
voice_asr_shadow_model = "whisper-large-v3-turbo"
voice_asr_temperature = 0.0
voice_cleanup_temperature = 0.2
voice_cleanup_max_tokens = 1800
voice_render_expandable_chapters = true
voice_send_full_file = true

static_files_dir = "/opt/tg-ai-bot-teloxide/static"

# One process/token owns one community instance. The chat map is the only
# runtime scope used for Telegram updates and chat-local data.
[instance]
id = "nedonews"
display_name = "НедоNews"
timezone = "Europe/Moscow"

[telegram]
unknown_chat_policy = "ignore"
owners = [5939287960]

[chats.main]
id = -1001932061163
ingest = true
delete_join_leave_messages = false
ephemeral_command_replies = false
# HTML-шаблоны приветствия и прощания; доступные поля описаны в docs/TECHNICAL.md.
# welcome_message = "Добро пожаловать, <b>{first_name}</b>!"
# farewell_message = "{full_name} покинул(а) чат."
moderation = true
manual_moderation = false
# moderation_delete_target_message = false
# moderation_delete_command_message = false
stats = true
voice = false
ask = false
invite_url_env = "CHAT_INVITE_URL"
invite_label = "чате"

[moderation]
enabled = false
review_delivery_enabled = true
risk_profile = "ru_general_v1"
review_chat = "main"
reviewer_user_ids = [5939287960]
cas_enabled = false
cas_timeout_sec = 5
enforce_enabled = false
enforce_dry_run = true
enforce_ban_threshold = 90
captcha_enabled = false
captcha_dry_run = true
captcha_threshold = 70
captcha_ttl_sec = 600
linear_spam_enabled = false
linear_spam_model_path = "/opt/tg-ai-bot-teloxide/models/linear_spam_word12_v1.json"
embedding_spam_enabled = false
embedding_spam_model_path = "/opt/tg-ai-bot-teloxide/models/embeddinggemma2_q4_classification_512_alt_2026-10-07.json"
reputation_enabled = false
reputation_model_path = "/opt/tg-ai-bot-teloxide/models/rep_v2_2026-10-04.json"

# Дешёвый текстовый каскад перед LLM; никогда не даёт права на autoban/captcha.
[moderation.local_cascade]
mode = "disabled" # disabled | shadow | review_only
template_similarity = 0.85
normal_veto_similarity = 0.80
min_template_authors = 2
linear_review_threshold = 0.99
min_text_chars = 32
min_tokens = 5
max_messages = 10
max_chat_age_seconds = 259200
max_corpus_examples = 5000

# Нативный Decisions API; не является generative route и не выдаёт санкции.
[moderation.decision]
enabled = false
external_processing_allowed = false
avatar_enabled = false
base_url = "https://generativelanguage.googleapis.com/v1beta"
api_key_env = "GEMINI_API_KEY"
model = "gemini-decision-1"
timeout_sec = 15
max_calls_per_hour = 30
max_pending_jobs = 100
max_input_chars = 2000
chat_policy = "Тематика и разрешения чата неизвестны. Не предполагай запрета предложений работы."

[manual_moderation]
enabled = false

[spam_reputation]
enabled = false
sqlite_path = "/var/lib/nedobot/spam-reputation.sqlite"

[voice]
enabled = false
private_enabled = false

[ask]
enabled = false
default_chat = "main"
agent_profile = "nedonews_default"

[first_comment]
enabled = true

[[first_comment.routes]]
source_channel_id = -1001575496091
discussion_chat = "main"
post_signature_marker = "Не теряем связь"
post_signature_aliases = ["😎НедоNews"]
blocked_post_terms = ["#реклама", "о рекламодателе"]
invite_label = "чате"
invite_url_env = "CHAT_INVITE_URL"
prompt_profile = "nedonews"

[public_mcp]
enabled = false

[risk_profiles.ru_general_v1]
version = "ru-general-v1"
old_user_message_threshold = 5
review_threshold = 70

[risk_profiles.ru_general_v1.telegram_id]
floor = 0.0066813
ceil = 1.0
k = 3.20435
midpoint_billion = 8.45919
version = "4pl-prod-2026-09-21"

[agent_profiles.nedonews_default]
identity = "NedoBot"
display_name = "NedoBot"
community_context = "НедоNews Chat (разрешена только его история)"
system_prompt_file = "builtin:nedonews_ask"
capability_document_file = "builtin:nedonews_changelog"
response_style = ""
model_route = "ask"
tool_allowlist = [
  "chat.resolve_user", "chat.get_user_profile", "chat.count_messages",
  "chat.count_word_occurrences", "chat.search_messages", "chat.search_messages_batch",
  "chat.get_recent_messages", "chat.get_message", "chat.get_message_context",
  "chat.get_reply_thread", "chat.get_user_interactions", "sandbox.python", "notes.list_chat",
  "notes.list_user", "notes.add_user", "web.search", "github.search",
  "youtube.get_subtitles", "voice.list_transcripts", "memory.list_notes"
]

[agent_profiles.nedonews_default.budgets]
max_steps = 64
max_tool_calls = 64
action_timeout_sec = 180
total_timeout_sec = 3600
max_output_tokens = 16384

[agent_profiles.nedonews_default.memory]
enabled = false
max_turns = 20
retention_days = 30
max_context_chars = 8000
write_policy = "explicit_only"
